{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(git push --force*)"
    ]
  },
  "effortLevel": "medium",
  "enabledPlugins": {
    "codex@openai-codex": true,
    "crit@crit": true,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": false,
    "qmd@qmd": false,
    "swift-lsp@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "repo": "tomasz-tomczyk/crit",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    },
    "qmd": {
      "source": {
        "repo": "tobi/qmd",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && { i=$(cat); printf '%s' \"$i\" | cmux claude-hook notification; m=$(printf '%s' \"$i\" | jq -r '.message // empty' 2>/dev/null); case \"$m\" in *\"waiting for your input\"*) : ;; *) cmux set-progress 0.5 --label waiting >/dev/null 2>&1 ;; esac; } || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux set-progress 0.5 --label working >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/sonar-secrets/build-scripts/pretool-secrets.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/no-poll-loops.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/prefer-python3.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/prefer-rg-fd.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux clear-progress >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux claude-hook session-start || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux clear-progress >/dev/null 2>&1 || true",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire $CLAUDE_CODE_SESSION_ID --tool claude-code",
            "type": "command"
          }
        ],
        "matcher": "clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && { cmux claude-hook stop; cmux set-progress 1.0 --label done >/dev/null 2>&1; (~/dotfiles/bin/cmux-pr-titles >/dev/null 2>&1 &); } || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release $CLAUDE_CODE_SESSION_ID --tool claude-code",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire --tool claude-code --subagent",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil release --tool claude-code --subagent",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && { cmux claude-hook prompt-submit; cmux set-progress 0.01 --label working >/dev/null 2>&1; } || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/Applications/Adrafinil.app/Contents/Helpers/adrafinil acquire $CLAUDE_CODE_SESSION_ID --tool claude-code",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/sonar-secrets/build-scripts/prompt-secrets.sh",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "claude-fable-5-1[1m]",
  "permissions": {
    "allow": [
      "Bash(* | grep*)",
      "Bash(* | head*)",
      "Bash(* | jq*)",
      "Bash(* | sort*)",
      "Bash(* | tail*)",
      "Bash(* | uniq*)",
      "Bash(* | wc*)",
      "Bash(./vendor/bin/pint *)",
      "Bash(./vendor/bin/sail *)",
      "Bash(./vendor/bin/sail artisan:*)",
      "Bash(./vendor/bin/sail exec app:*)",
      "Bash(./vendor/bin/sail test:*)",
      "Bash(./vendor/bin/sail up:*)",
      "Bash(awk*)",
      "Bash(basename *)",
      "Bash(black --check*)",
      "Bash(black --diff*)",
      "Bash(cat *)",
      "Bash(cmux *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(dirname *)",
      "Bash(echo *)",
      "Bash(eslint *)",
      "Bash(false *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(gh api repos/:owner/:repo/pulls/$(gh pr view --json number --jq .number)/comments:*)",
      "Bash(gh auth status*)",
      "Bash(gh pr view --comments)",
      "Bash(gh pr view --json body --jq .body:*)",
      "Bash(gh pr*)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jira issue view *)",
      "Bash(jq *)",
      "Bash(less *)",
      "Bash(ls*)",
      "Bash(make -n*)",
      "Bash(make test*)",
      "Bash(man *)",
      "Bash(mkdir:*)",
      "Bash(mv *)",
      "Bash(mypy*)",
      "Bash(npm list*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm test*)",
      "Bash(printf *)",
      "Bash(pwd *)",
      "Bash(pydoc *)",
      "Bash(pylint *)",
      "Bash(pytest *)",
      "Bash(readlink *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(rtk *)",
      "Bash(sed -n *)",
      "Bash(serena:*)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(tree *)",
      "Bash(true *)",
      "Bash(type *)",
      "Bash(uniq*)",
      "Bash(vendor/bin/pint *)",
      "Bash(vendor/bin/sail *)",
      "Bash(wc*)",
      "Bash(which *)",
      "Bash(yq eval*)",
      "Edit(**)",
      "Grep(**)",
      "Read(**)",
      "Read(~/.claude/*)",
      "Read(~/.zshrc)",
      "Read(~/dotfiles/.ai/skills/**)",
      "TodoWrite(**)",
      "mcp__serena"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git clone:*)",
      "Bash(rm -rf :*)",
      "Bash(vendor/bin/phpstan *)"
    ]
  },
  "preferredNotifChannel": "terminal_bell",
  "skillOverrides": {
    "agent-browser": "off",
    "ccc": "off",
    "claude": "off",
    "close-spec": "off",
    "compare-screenshots": "off",
    "custom-email-html-template-review": "off",
    "custom-fable-mode": "off",
    "custom-install-all-dependencies": "off",
    "eval-skills": "off",
    "explore-unknowns": "off",
    "figma": "off",
    "figma-implement-design": "off",
    "find-skills": "off",
    "implement-spec": "off",
    "implement-spec-with-codex": "off",
    "playwright": "off",
    "playwright-interactive": "off",
    "preview-shots": "off",
    "refactor-clean": "off",
    "renderer": "off",
    "screenshot-critique": "off",
    "sentry-cli": "off",
    "write-docs": "off",
    "write-spec": "off",
    "write-tests": "off"
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "~/dotfiles/bin/ccstatusline-rounded",
    "padding": 0,
    "type": "command"
  },
  "theme": "custom:my-theme",
  "tui": "fullscreen"
}
