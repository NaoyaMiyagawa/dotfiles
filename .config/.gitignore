# ----------------------------------------------------------------------------
# Ignore All (base settings)
# ----------------------------------------------------------------------------
/*
/.**

# starship.toml
!starship.toml

# karabiner
!karabiner/*.json
!karabiner/assets
!karabiner/assets/**

# iterm2
!iterm2/com.googlecode.iterm2.plist

# lazygit
!lazygit/
!lazygit/**

# git
!git/
!git/**
# work identity holds an employer email address — keep it out of this public repo
git/conf.d/work.conf

# opencode
!opencode/oh-my-opencode.json
!opencode/opencode.json

# tmux
!tmux/
!tmux/**

# cmux
!cmux/
cmux/*
!cmux/cmux.json
!cmux/sidebars/
!cmux/sidebars/**
!cmux/com.miyagawa.cmux-pr-titles.plist

# vscode
!vscode/
!vscode/**

# phpantom_lsp (PHP language server global config)
!phpantom_lsp/
!phpantom_lsp/.phpantom.toml

# zed (config only — not caches/embeddings/conversations)
!zed/
!zed/settings.json
!zed/keymap.json
!zed/tasks.json

# zsh
!zsh/
!zsh/**
zsh/secrets.local.zsh
