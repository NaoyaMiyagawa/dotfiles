##############################################################################
# gitignore
##############################################################################

# ----------------------------------------------------------------------------
# Ignore All (base settings)
# ----------------------------------------------------------------------------
/*
/.**

# ----------------------------------------------------------------------------
# WhiteList: Add path to manage in git
#
# !/.zfunc/
# /.zfunc/** # eample of when you want directory but not files inside
# ----------------------------------------------------------------------------

# dotfile installer
!/Makefile
!/Brewfile

# bin (helper scripts referenced by hooks/config)
!/bin/
!/bin/**

# editor workspace settings (hides untracked runtime data from the explorer/watcher)
!/.vscode/
!/.vscode/settings.json

# github
!/README.md
!/LICENSE
!.gitignore
!.gitkeep
!/.gitattributes

# .ai
!/.ai
!/.ai/.gitignore

# zsh
!/.zshrc
!/.zprofile
!/.zshenv

# .claude
!/.claude/
/.claude/**
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/hooks/
!/.claude/hooks/no-poll-loops.sh
!/.claude/themes/
!/.claude/themes/my-theme.json
!/.claude/scheduled-tasks/
!/.claude/scheduled-tasks/*/
!/.claude/scheduled-tasks/*/SKILL.md
!/.claude/scheduled-tasks/*/scripts/
!/.claude/scheduled-tasks/*/scripts/**

# .config
!/.config
/.config/zsh/secrets.local.zsh

# vim
!/.vimrc
!/.vim
/.vim/**
!/.vim/colors
!/.vim/colors/*

# linter
!/.stylelintrc.js
